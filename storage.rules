rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Reglas para imágenes de perfil
    match /profile_images/{userId} {
      // Permitir lectura a todos (para ver avatares)
      allow read: if true;
      // Permitir escritura solo al dueño del perfil
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para subidas de vehículos (add-car.tsx usa uploads/{userId}/...)
    match /uploads/{userId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas por defecto para otros casos (ajustar según necesidad)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; 
    }
  }
}