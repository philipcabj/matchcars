{
  "expo": {
    "name": "Matchcars",
    "slug": "matchcars",
    "version": "1.1.7",
    "orientation": "portrait",
    "icon": "./assets/images/icono.png",
    "scheme": "matchcars",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.matchcars.app",
      "associatedDomains": ["applinks:matchcars.app"],
      "buildNumber": "1.1.7",
      "googleServicesFile": "./GoogleService-Info.plist",
      "newArchEnabled": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Matchcars necesita acceder a tu galería de fotos para que puedas seleccionar imágenes de tus vehículos y subirlas a tus publicaciones de venta, así como para actualizar tu foto de perfil.",
        "NSCameraUsageDescription": "Matchcars necesita acceder a tu cámara para que puedas tomar fotos de tus vehículos o de tu perfil directamente desde la aplicación.",
        "NSLocationWhenInUseUsageDescription": "Matchcars necesita tu ubicación para sugerir la dirección de tu agencia."
      }
    },
    "notification": {
      "icon": "./assets/images/android-icon-monochrome.png",
      "color": "#2563EB",
      "iosDisplayInForeground": true
    },
    "android": {
      "package": "com.matchcars.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "matchcars.app",
              "pathPrefix": "/car"
            },
            {
              "scheme": "https",
              "host": "matchcars.app",
              "pathPrefix": "/user-profile"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "newArchEnabled": true,
      "versionCode": 17,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icono.png",
        "backgroundImage": "./assets/images/icono.png",
        "monochromeImage": "./assets/images/icono.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icono.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icono.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E1117",
          "dark": {
            "backgroundColor": "#0E1117"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#00A3FF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Matchcars necesita acceder a tu galería para subir fotos de vehículos o perfil.",
          "cameraPermission": "Matchcars necesita acceder a tu cámara para tomar fotos de vehículos o perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Matchcars to use your location."
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "windowSoftInputMode": "adjustResize"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64f57206-4719-4eff-afdc-1754a37344bd"
      }
    },
    "owner": "fguarino"
  }
}
