rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar rol de admin o moderador
    // Verifica primero el token (custom claim) y luego el documento del usuario en Firestore
    function isStaff() {
      return request.auth != null && (
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role in ['admin', 'moderator']) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'])
      );
    }

    // Función auxiliar para verificar si el usuario es dueño del recurso
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Reglas para usuarios (perfiles)
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isOwner(userId) || isStaff() || (
        request.auth != null &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.firstName == resource.data.firstName &&
        request.resource.data.lastName == resource.data.lastName &&
        request.resource.data.plan == resource.data.plan
      );
      
      match /price_alert_notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if request.auth != null;
        allow update, delete: if isOwner(userId);
      }

      match /offer_notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if request.auth != null;
        allow update: if isOwner(userId);
      }

      match /{document=**} {
        allow read, write: if isOwner(userId) || isStaff();
      }
    }

    // Reglas para reportes
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null; // Usuarios pueden ver reportes (o restringir a staff/creador)
      allow update: if isStaff(); // Solo staff puede resolver/actualizar reportes
    }

    // Reglas para ventas
    match /sales/{saleId} {
      function isSaleInvolved() {
        return request.auth != null && (
          resource.data.sellerId == request.auth.uid ||
          resource.data.buyerId == request.auth.uid
        );
      }
      allow read: if request.auth != null;
      // El vendedor crea el registro de venta (sellerId debe ser el usuario autenticado)
      allow create: if request.auth != null && (
        request.resource.data.sellerId == request.auth.uid ||
        request.resource.data.buyerId == request.auth.uid
      );
      allow update: if isSaleInvolved() || isStaff();
      allow delete: if isSaleInvolved() || isStaff();
    }

    // Progreso de carga masiva (bulk-import.tsx). Solo la Cloud Function
    // startBulkImport escribe, vía Admin SDK, que ignora estas reglas.
    match /bulkImportJobs/{jobId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Reglas para vehículos
    match /vehicles/{vehicleId} {
      allow read: if true;
      // El userId del documento debe coincidir con el usuario autenticado.
      // El límite de publicaciones por plan se valida via Cloud Function (enforceVehicleLimit).
      // riskFlags/riskScore se calculan y envían desde el cliente al momento de publicar.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        isStaff() ||
        // Owner by userId or uid field
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.uid ||
        // Mark as sold: verified via offer document (sellerId == auth, vehicleId matches, status accepted)
        (
          request.resource.data.status == "sold" &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.soldViaOfferId is string &&
          get(/databases/$(database)/documents/offers/$(request.resource.data.soldViaOfferId)).data.sellerId == request.auth.uid &&
          get(/databases/$(database)/documents/offers/$(request.resource.data.soldViaOfferId)).data.vehicleId == vehicleId &&
          get(/databases/$(database)/documents/offers/$(request.resource.data.soldViaOfferId)).data.status == "accepted"
        ) ||
        // Non-owner update without changing key fields (e.g., view count increments)
        (
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.price == resource.data.price &&
          request.resource.data.currency == resource.data.currency
        ) ||
        // Comprador confirma/deniega recepción tras "marcar como vendido"
        // (chat/[uid].tsx handleConfirmReceived/handleDenyReceived): el auto
        // queda "reserved" hasta que el comprador lo cierra a "sold" o lo
        // devuelve a "available". Verificado contra sales/{vehicleId}.buyerId
        // (mismo id que el vehículo) en vez de confiar en el uid del request;
        // no puede tocar dueño/precio/moneda ni salir de ese único paso.
        (
          resource.data.status == "reserved" &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.price == resource.data.price &&
          request.resource.data.currency == resource.data.currency &&
          (request.resource.data.status == "sold" || request.resource.data.status == "available") &&
          get(/databases/$(database)/documents/sales/$(vehicleId)).data.buyerId == request.auth.uid
        )
      );
      allow delete: if request.auth != null && (
        isStaff() ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.uid
      );
      
      match /price_alerts/{userId} {
        allow read: if isOwner(userId) || (request.auth != null && get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.userId == request.auth.uid);
        allow write: if isOwner(userId);
      }
    }

    // Reglas para el catálogo
    match /catalog/{document=**} {
      allow read: if true;
      allow write: if isStaff(); // Solo staff debería modificar el catálogo
    }

    // Reglas para tabla de referencia de precios (Cámara / price_reference)
    match /price_reference/{docId} {
      // Los precios de referencia no son datos sensibles: se pueden leer públicamente
      allow read: if true;
      // Solo staff (o scripts con credenciales de service account) deberían escribir aquí
      allow write: if isStaff();
    }
    
    // Configuración general (por ejemplo, cotización USD/ARS)
    match /config/{docId} {
      // La configuración no es sensible (por ahora): se puede leer públicamente
      allow read: if true;
      // Solo staff puede actualizar configuración global
      allow write: if isStaff();
    }
    
    // Reglas para chats y conversaciones
    match /chats/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /conversations/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Reglas para correos (Trigger Email Extension)
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isStaff() || (request.auth != null && resource.data.toUids[0] == request.auth.uid);
    }

    // Reglas para leads de CRM (simplificadas: cualquier usuario autenticado puede leer/escribir sus leads)
    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }

    // Reglas para ofertas formales
    match /offers/{offerId} {
      function isOfferParty() {
        return request.auth != null && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.sellerId == request.auth.uid
        );
      }
      allow read: if request.auth != null && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isStaff()
      );
      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid;
      allow update: if isOfferParty() || isStaff();
      allow delete: if isStaff();
    }

    // Reglas para reseñas de vendedores
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.reviewerId != request.resource.data.sellerId;
      allow update, delete: if isStaff();
    }

    // ── Portal de agencias (nuevo, en construcción) ──────────────────────────
    // Modelo v1: agencyId == uid del usuario dueño (el mismo usuario "pro_dealer"
    // que ya existe en /users). No requiere migración de datos existentes: el
    // doc en /agencies/{agencyId} se crea recién cuando el dueño entra por primera
    // vez al portal. /members permite, a futuro, sumar empleados con roles sin
    // tocar el modelo actual de un usuario = una cuenta.
    function isAgencyMember(agencyId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/agencies/$(agencyId)/members/$(request.auth.uid));
    }
    function agencyMemberRole(agencyId) {
      return get(/databases/$(database)/documents/agencies/$(agencyId)/members/$(request.auth.uid)).data.role;
    }
    function canManageAgency(agencyId) {
      return request.auth != null && (
        request.auth.uid == agencyId ||
        isStaff() ||
        (isAgencyMember(agencyId) && agencyMemberRole(agencyId) in ['owner', 'manager'])
      );
    }

    match /agencies/{agencyId} {
      allow read: if true;
      allow create, update, delete: if canManageAgency(agencyId);

      match /members/{memberId} {
        allow read: if request.auth != null && (canManageAgency(agencyId) || request.auth.uid == memberId);
        allow write: if canManageAgency(agencyId);
      }
    }

    // Índice inverso uid -> agencia (para que un miembro invitado, con su propio
    // uid distinto de agencyId, sepa a qué agencia pertenece al entrar al portal).
    // Solo lo escribe el backend del portal (Admin SDK, bypassea reglas) al
    // invitar/quitar miembros — por eso "write: if false" acá.
    match /agencyMemberships/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow write: if false;
    }
  }
}
